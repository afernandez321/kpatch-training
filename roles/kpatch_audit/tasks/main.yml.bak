---
- name: Check Kpatch installation
  ansible.builtin.command: rpm -q kpatch
  register: kpatch_package
  changed_when: false
  failed_when: false

- name: Check kernel livepatch support
  ansible.builtin.command:
    argv:
      - grep
      - -E
      - '^CONFIG_LIVEPATCH=y$'
      - "/boot/config-{{ ansible_kernel }}"
  register: livepatch_support
  changed_when: false
  failed_when: false

- name: List Kpatch modules
  ansible.builtin.command: kpatch list
  register: kpatch_modules
  changed_when: false
  failed_when: false
  when: kpatch_package.rc == 0

- name: Collect Kpatch service status
  ansible.builtin.command: systemctl is-enabled kpatch
  register: kpatch_service
  changed_when: false
  failed_when: false

- name: Display Kpatch audit report
  ansible.builtin.debug:
    msg:
      - "===== KPATCH AUDIT ====="
      - "Host: {{ inventory_hostname }}"
      - "OS: {{ ansible_distribution }} {{ ansible_distribution_version }}"
      - "Kernel: {{ ansible_kernel }}"
      - "Kpatch installed: {{ 'PASS' if kpatch_package.rc == 0 else 'FAIL' }}"
      - "Kernel livepatch support: {{ 'PASS' if livepatch_support.rc == 0 else 'FAIL' }}"
      - "Kpatch service enabled: {{ 'YES' if kpatch_service.stdout == 'enabled' else 'NO' }}"
      - "Patch listing: {{ kpatch_modules.stdout_lines | default(['Kpatch not installed'], true) }}"
      - "FINAL RESULT: {{ 'PASS - Kpatch ready for audit' if kpatch_package.rc == 0 and livepatch_support.rc == 0 else 'WARN - Kpatch prerequisites incomplete' }}"
